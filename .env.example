DATABASE_URL="postgresql://leaddesk:leaddesk@localhost:5433/leaddesk?schema=public"
# Set to 1 to serve in-memory example data with no database. Demo mode is also
# used automatically when DATABASE_URL is not set (e.g. a frontend-only deploy).
LEADDESK_DEMO=0

# Verified by app/api/cron/auto-close-leads — must match the Authorization
# header Vercel Cron sends (or whatever calls that route). Set a real
# secret in the Vercel project's env vars for production.
CRON_SECRET="your_cron_secret"
