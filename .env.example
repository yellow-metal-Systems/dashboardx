# =============================================================================
# LEADDESK (dashboardx) — ENVIRONMENT
# =============================================================================
# lib/env.ts validates this at module init and THROWS in production if anything
# required is missing, so a misconfigured deploy fails at boot instead of quietly
# serving example data.

# -----------------------------------------------------------------------------
# Database (Supabase) — the SAME database the serverx repo uses
# -----------------------------------------------------------------------------
# Both apps read and write one shared `leads` table. There is no sync step and no
# separate schema: `?schema=dashboard` was removed along with this app's
# migrations, since serverx owns the schema.
#
# ⚠ DO NOT USE the direct `db.<project-ref>.supabase.co` hostname. It has no A
#   record (verified for this project — IPv6 only, unless you buy Supabase's IPv4
#   add-on) and Vercel Lambdas have no IPv6 egress, so it simply cannot connect
#   from a deployed environment.
#
# DATABASE_URL — TRANSACTION pooler (:6543). `pgbouncer=true` is mandatory: it
#   turns off Prisma's prepared statements, which PgBouncer's transaction mode
#   cannot support. Without it you get intermittent
#   `prepared statement "s0" already exists` under load. connection_limit=1
#   because each concurrent lambda gets its own client.
# DIRECT_URL — SESSION pooler (:5432 on the pooler host). Prisma routes
#   `db pull`, introspection and Studio through this. Required, because this repo
#   runs `db pull` after every serverx migration.
#
# From: Supabase dashboard -> Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=15&sslmode=require"
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# Staff authentication
# -----------------------------------------------------------------------------
# Signing key for the `ym_admin_session` cookie. iron-session encrypts the session
# INTO the cookie, so there is no session table — which is why middleware.ts can
# verify it at the edge with no database query. Minimum 32 characters.
# Generate with:  openssl rand -base64 32
# REQUIRED in production: without it every /dashboard route and server action
# would be unauthenticated, and startup refuses.
SESSION_SECRET="replace_me_openssl_rand_base64_32"

# Session lifetime in seconds. Default 8 hours — one working day.
SESSION_TTL_SECONDS=28800

# Used ONLY by `npm run db:create-admin` to create a staff login. Read once and
# never stored. Minimum 12 characters.
# ADMIN_EMAIL="you@yellowmetal.example"
# ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# The serverx service
# -----------------------------------------------------------------------------
# Used for two read-only calls: the max-eligible-loan figures (serverx owns the
# live gold-rate lookup) and the integration-health banner. Status changes do NOT
# go over HTTP — they are written to the shared table plus a lead_status_outbox
# row in one transaction, which serverx drains.
SERVER_BASE_URL="http://localhost:8080"

# Must match INTERNAL_API_KEY in serverx/.env exactly. Without it those two
# figures simply do not render; nothing else breaks.
INTERNAL_API_KEY="replace_me_matching_serverx_internal_api_key"

# -----------------------------------------------------------------------------
# Removed
# -----------------------------------------------------------------------------
# CRON_SECRET — gone. /api/cron/auto-close-leads was deleted: lead expiry is now
#   owned solely by serverx's hourly LeadLifecycleService. Two expiry jobs over one
#   shared table would race on the same rows.
# LEADDESK_DEMO — gone, along with all demo/example data. This app has no mode in
#   which it runs without a real database.
# ONDC_INTERNAL_API_KEY — gone with scripts/sync-ondc-leads.ts. It was never in
#   this file, which is why a missing key surfaced as a confusing 401 from the
#   backend rather than "you forgot to set it". Superseded by INTERNAL_API_KEY.
