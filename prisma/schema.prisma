// =============================================================================
// LeadDesk — Prisma schema. THIS REPO OWNS NO MIGRATIONS.
// =============================================================================
//
// These tables are SHARED with the `serverx` repo (the Express service that
// serves the AarthikLabs/ONDC contracts). serverx's prisma/schema.prisma is the
// single source of truth for the physical schema and the only place migrations
// are authored. This file is a client-generation artefact.
//
// AFTER serverx SHIPS A MIGRATION:
//   npx prisma db pull      # rewrites this file from the live database
//   npx prisma generate
// then re-apply by hand the two conventions `db pull` flattens:
//   1. camelCase field names with @map("snake_case") — db pull renames fields to
//      raw column names, which would break every call site in this repo.
//   2. the model-level comments below.
//
// NEVER run `prisma migrate dev`, `prisma migrate deploy` or `prisma db push`
// here. Any of them would try to reshape tables serverx owns. The `db:migrate`
// script was removed from package.json for this reason, and prisma/migrations/
// was deleted (its one migration never even created the distributor_ref_id
// column this schema used to declare, so it was not a truthful record of the
// database anyway).
//
// WHICH COLUMNS THIS REPO MAY WRITE:
//   status, acceptanceState, duplicateFlag, branchManagerStatus,
//   loanConfirmedAmount, loanConfirmedAt, partnerId, source, loanAmount,
//   offerAmount, ltvPercent, kfsReference
//   ...plus everything on Partner, LeadActivity, LeadStatusOutbox and AdminUser.
// Partner-owned columns (customerId, loanId, disbursement*, productType, tenure*,
// offerAcceptedAt, ondcTransactionId, lspName, offer* and the borrower identity
// fields) are written by serverx. loanAmount is written by this repo for
// partner-referral leads and by serverx for AarthikLabs leads.
// Reading any column is always fine.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadSource {
  PARTNER
  AARTHIKLABS
  // An organisation via LeadBridge's /api/v1 (serverx migration 4).
  PARTNER_API
}

enum PartnerStatus {
  invited
  active
  disabled
}

enum AcceptanceState {
  NA
  ACCEPTED
  EXPIRED_UNACCEPTED
}

enum BranchManagerStatus {
  NOT_SENT
  SENT
  CONFIRMED
  DECLINED
}

enum ActivityKind {
  SUBMITTED
  STATUS_CHANGED
  DISBURSEMENT_RECORDED
  AUTO_CLOSED
  WEBHOOK_QUEUED
  WEBHOOK_DELIVERED
  WEBHOOK_FAILED
}

// NOTE: there is deliberately NO `LeadStatus` enum. `status` is a text column
// carrying the canonical UPPER_SNAKE vocabulary (LEAD_CREATED, CONTACTED,
// BRANCH_VISIT_SCHEDULED, DISBURSED, REJECTED), because AarthikLabs confirmed the
// vocabulary is ours to extend and adding a value must not require a migration.
// Parse it through `parseLeadStatus()` in lib/leads.ts, which tolerates an
// unrecognised value instead of crashing the page.

model Lead {
  id      String @id
  leadNo  Int    @unique @default(autoincrement()) @map("lead_no")

  customerId String? @map("customer_id")
  loanId     String? @unique @map("loan_id")

  source    LeadSource @default(PARTNER)
  partnerId String?    @map("partner_id")

  /// AarthikLabs' ONDC reconciliation key. Null on partner-referral leads.
  ondcTransactionId String? @map("ondc_transaction_id")
  /// The ONDC lead-generating app the borrower came through.
  lspName           String? @map("lsp_name")

  name          String
  mobile        String    @map("mobile_number")
  pinCode       String    @map("pincode")
  addressLine1  String?   @map("address_line_1")
  addressLine2  String?   @map("address_line_2")
  dob           DateTime? @map("date_of_birth") @db.Date
  gender        String?
  /// PII. Never render this in the UI or include it in a log line.
  pan           String?

  goldGrams       Decimal?  @map("gold_weight_grams") @db.Decimal(10, 3)
  loanAmount      Decimal?  @map("loan_amount") @db.Decimal(12, 2)
  offerAmount     Decimal?  @map("offer_amount") @db.Decimal(12, 2)
  ltvPercent      Decimal?  @map("ltv_percent") @db.Decimal(5, 2)
  kfsReference    String?   @map("kfs_reference")
  offerAcceptedAt DateTime? @map("offer_accepted_at") @db.Timestamptz(3)

  /// Provisional ONDC offer, exactly as the borrower saw it. NOT the disbursed
  /// loan — that is productType/tenure below.
  offerProductType   String?  @map("offer_product_type")
  offerRoiPercentPa  Decimal? @map("offer_roi_percent_pa") @db.Decimal(5, 2)
  offerProcessingFee Decimal? @map("offer_processing_fee") @db.Decimal(12, 2)
  offerTenureDays    Int?     @map("offer_tenure_days")

  status String @default("LEAD_CREATED")

  acceptanceState     AcceptanceState     @default(NA) @map("acceptance_state")
  duplicateFlag       Boolean             @default(false) @map("duplicate_flag")
  branchManagerStatus BranchManagerStatus @default(NOT_SENT) @map("branch_manager_status")
  loanConfirmedAmount Decimal?            @map("loan_confirmed_amount") @db.Decimal(12, 2)
  loanConfirmedAt     DateTime?           @map("loan_confirmed_at") @db.Timestamptz(3)

  disbursementAmount Decimal?  @map("disbursement_amount") @db.Decimal(12, 2)
  disbursementDate   DateTime? @map("disbursement_date") @db.Date
  productType        String    @default("TERM_LOAN") @map("product_type")
  tenure             Int?
  tenureUnit         String    @default("MONTH") @map("tenure_unit")

  isDemo          Boolean   @default(false) @map("is_demo")
  sourceCreatedAt DateTime? @map("source_created_at") @db.Timestamptz(3)

  // LeadBridge partner app / organisation API (serverx migrations 3-4)
  submittedByUserId String?   @map("submitted_by_user_id")
  borrowerConsentAt DateTime? @map("borrower_consent_at") @db.Timestamptz(3)
  consentVersion    String?   @map("consent_version")
  /// The customer's GSTIN, when their business is GST-registered.
  gstin             String?   @db.VarChar(15)
  /// Branch from serverx src/data/branches.ts.
  branchId          String?   @map("branch_id")
  externalRef       String?   @map("external_ref")
  agentRef          String?   @map("agent_ref")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  partner       Partner?           @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  submittedBy   PartnerUser?       @relation(fields: [submittedByUserId], references: [id], onDelete: SetNull)
  reward        PartnerReward?
  lmsEvents     LmsLoanEvent[]
  activities    LeadActivity[]
  webhookEvents WebhookEvent[]
  statusOutbox  LeadStatusOutbox[]

  @@index([mobile])
  @@index([pinCode])
  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@index([source])
  @@index([partnerId])
  @@index([ondcTransactionId])
  @@index([loanAmount])
  @@index([offerAmount])
  @@index([status, createdAt])
  @@index([branchId])
  @@map("leads")
}

model Partner {
  id           String        @id @default(cuid())
  orgName       String        @map("org_name")
  contactEmail  String        @map("contact_email")
  contactMobile String?       @map("contact_mobile")
  status        PartnerStatus @default(invited)
  type          PartnerType   @default(INDIVIDUAL)
  isOndc        Boolean       @default(false) @map("is_ondc")
  isDemo       Boolean       @default(false) @map("is_demo")
  /// Staff switch: this partner's leads must carry the customer's GSTIN.
  gstinRequired Boolean      @default(false) @map("gstin_required")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  leads         Lead[]
  users         PartnerUser[]
  apiKeys       PartnerApiKey[]
  rewards       PartnerReward[]
  payoutDetails PartnerPayoutDetails?
  payoutDetailsHistory PartnerPayoutDetailsHistory[]
  rewardAuditLog       RewardAuditLog[]

  @@index([contactEmail])
  @@map("partners")
}

model LeadActivity {
  id         String       @id @default(cuid())
  leadId     String       @map("lead_id")
  kind       ActivityKind
  /// Text, not an enum — it must be able to hold any canonical status value.
  fromStatus String?      @map("from_status")
  toStatus   String?      @map("to_status")
  message    String
  /// An admin_users email for staff actions, or a "system:<job>" sentinel.
  actor      String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

/// Read-only here. serverx owns delivery; this repo only displays the history.
model WebhookEvent {
  id             String    @id @default(uuid())
  leadId         String    @map("lead_id")
  statusSent     String    @map("status_sent")
  payload        String
  deliveryStatus String    @default("pending") @map("delivery_status")
  attempts       Int       @default(0)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(3)
  lastAttemptAt  DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  nextRetryAt    DateTime? @map("next_retry_at") @db.Timestamptz(3)
  responseCode   Int?      @map("response_code")
  responseBody   String?   @map("response_body")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([deliveryStatus, nextRetryAt])
  @@map("webhook_events")
}

/// This repo INSERTs here, in the same transaction as a status change. serverx
/// drains it and dispatches the AarthikLabs webhook. Never update or delete a row
/// from this side.
model LeadStatusOutbox {
  seq         BigInt    @id @default(autoincrement())
  leadId      String    @map("lead_id")
  status      String
  actor       String?
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([processedAt, seq])
  @@map("lead_status_outbox")
}

/// Replay protection for serverx's POST /api/v1/leads. Not used by this repo;
/// declared so `prisma db pull` does not report it as drift.
model IdempotencyKey {
  key         String   @id
  endpoint    String
  requestHash String   @map("request_hash")
  statusCode  Int      @map("status_code")
  response    String
  leadId      String?  @map("lead_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("idempotency_keys")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  /// Argon2id hash. Never a plaintext or reversible value.
  passwordHash String    @map("password_hash")
  role         String    @default("staff")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("admin_users")
}

// -----------------------------------------------------------------------------
// Partners, their logins, API keys and rewards (serverx migrations 3-5).
// Copied from LeadBridge's schema, which maps the same columns with the same
// field names, so the moved code in lib/partners works unchanged. Partner
// logins live in LeadBridge (the partner app); LeadDesk onboards partners,
// issues invites and API keys, and approves and pays rewards. Rewards are
// CALCULATED only by serverx (RewardService).
// -----------------------------------------------------------------------------

enum PartnerType {
  ORGANISATION
  INDIVIDUAL
}

model PartnerUser {
  id           String        @id @default(cuid())
  partnerId    String        @map("partner_id")
  name         String
  mobile       String        @unique @map("mobile_number")
  email        String?
  passwordHash String?       @map("password_hash")
  status       PartnerStatus @default(invited)
  lastLoginAt  DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  partner Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  invites PartnerInvite[]
  leads   Lead[]

  @@map("partner_users")
}

model PartnerInvite {
  id            String    @id @default(cuid())
  partnerUserId String    @map("partner_user_id")
  tokenHash     String    @unique @map("token_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user PartnerUser @relation(fields: [partnerUserId], references: [id], onDelete: Cascade)

  @@map("partner_invites")
}

model PartnerApiKey {
  id         String    @id @default(cuid())
  partnerId  String    @map("partner_id")
  label      String
  keyPrefix  String    @unique @map("key_prefix")
  keyHash    String    @map("key_hash")
  createdBy  String?   @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_api_keys")
}

enum RewardKind {
  LOAN
  MONTHLY_BONUS
}

enum RewardStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model PartnerReward {
  id             String       @id @default(cuid())
  kind           RewardKind   @default(LOAN)
  /// LOAN only.
  leadId         String?      @unique @map("lead_id")
  partnerId      String       @map("partner_id")
  /// MONTHLY_BONUS only: first day of the month (IST).
  periodMonth    DateTime?    @map("period_month") @db.Date
  /// LOAN: the disbursed amount. MONTHLY_BONUS: the month's disbursed total.
  baseAmount     Decimal      @map("base_amount") @db.Decimal(14, 2)
  /// 1.000 = 1%
  percent        Decimal      @db.Decimal(6, 3)
  amount         Decimal      @db.Decimal(12, 2)
  status         RewardStatus @default(PENDING)
  disbursedAt    DateTime     @map("disbursed_at") @db.Timestamptz(3)
  approvedAt     DateTime?    @map("approved_at") @db.Timestamptz(3)
  approvedBy     String?      @map("approved_by")
  paidAt         DateTime?    @map("paid_at") @db.Timestamptz(3)
  paidBy         String?      @map("paid_by")
  paymentRef     String?      @map("payment_ref")
  tdsAmount      Decimal?     @map("tds_amount") @db.Decimal(12, 2)
  rejectedAt     DateTime?    @map("rejected_at") @db.Timestamptz(3)
  rejectedReason String?      @map("rejected_reason")
  rejectedBy     String?      @map("rejected_by")
  /// The exact bank details paid to (immutable history row).
  paidDetailsId  String?      @map("paid_details_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead        Lead?                        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  partner     Partner                      @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  paidDetails PartnerPayoutDetailsHistory? @relation(fields: [paidDetailsId], references: [id], onDelete: Restrict)
  auditLog    RewardAuditLog[]

  @@unique([partnerId, periodMonth])
  @@map("partner_rewards")
}

model RewardRate {
  id             String   @id @default(cuid())
  basePercent    Decimal  @map("base_percent") @db.Decimal(6, 3)
  bonusPercent   Decimal  @map("bonus_percent") @db.Decimal(6, 3)
  bonusThreshold Decimal  @map("bonus_threshold") @db.Decimal(14, 2)
  effectiveFrom  DateTime @map("effective_from") @db.Timestamptz(3)
  createdBy     String?  @map("created_by")
  /// Why the rules changed (required for every change).
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("reward_rates")
}

model PartnerPayoutDetails {
  partnerId     String   @id @map("partner_id")
  pan           String
  accountHolder String   @map("account_holder")
  accountNumber String   @map("account_number")
  ifsc          String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_payout_details")
}

// --- reward controls (serverx migration 6) ---
model PartnerPayoutDetailsHistory {
  id            String   @id @default(cuid())
  partnerId     String   @map("partner_id")
  pan           String
  accountHolder String   @map("account_holder")
  accountNumber String   @map("account_number")
  ifsc          String
  savedAt       DateTime @default(now()) @map("saved_at") @db.Timestamptz(3)
  savedBy       String?  @map("saved_by")

  partner Partner         @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  paid    PartnerReward[]

  @@index([partnerId, savedAt])
  @@map("partner_payout_details_history")
}

enum RewardAuditAction {
  APPROVED
  REJECTED
  PAID
  AMOUNT_UPDATED
  RULES_CHANGED
  DETAILS_REVEALED
  CLAWBACK_NEEDED
}

/// Append-only (a trigger refuses UPDATE/DELETE).
model RewardAuditLog {
  id        String            @id @default(cuid())
  partnerId String?           @map("partner_id")
  rewardId  String?           @map("reward_id")
  action    RewardAuditAction
  actor     String
  at        DateTime          @default(now()) @db.Timestamptz(3)
  details   Json?

  partner Partner?       @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  reward  PartnerReward? @relation(fields: [rewardId], references: [id], onDelete: Restrict)

  @@index([partnerId, at])
  @@index([rewardId])
  @@map("reward_audit_log")
}

// --- LMS loan events (serverx migration 7) ---
enum LmsLoanEventType {
  DISBURSED
  REJECTED
  CANCELLED
}

enum LmsEventOutcome {
  APPLIED
  NO_CHANGE
  UNMATCHED
  AMBIGUOUS
}

model LmsLoanEvent {
  id               String           @id @default(cuid())
  eventId          String           @unique @map("event_id")
  loanId           String?          @map("loan_id")
  leadIdSent       String?          @map("lead_id_sent")
  mobileSent       String?          @map("mobile_sent")
  event            LmsLoanEventType
  amount           Decimal?         @db.Decimal(14, 2)
  disbursementDate DateTime?        @map("disbursement_date") @db.Date
  reason           String?
  occurredAt       DateTime?        @map("occurred_at") @db.Timestamptz(3)
  payload          Json
  outcome          LmsEventOutcome
  matchedLeadId    String?          @map("matched_lead_id")
  receivedAt       DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)
  resolvedBy       String?          @map("resolved_by")
  resolvedAt       DateTime?        @map("resolved_at") @db.Timestamptz(3)

  matchedLead Lead? @relation(fields: [matchedLeadId], references: [id], onDelete: Restrict)

  @@index([outcome])
  @@index([matchedLeadId])
  @@map("lms_loan_events")
}
